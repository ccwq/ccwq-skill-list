# ChatGPT Web skill must reuse the existing logged-in Chrome CDP endpoint.
AGENT_BROWSER_CDP_PORT=9696
AGENT_BROWSER_USE_DEFAULT_CDP_SESSION=1

# 在.claude-plugin/marketplace.json中加入
MAIN_LIST=chatgpt-web-skill,debug-instrumentation,\
dockerhub-mirror,git-up,joint-debugging,ntl-script-descriptions,\
pro-grilling,project-self-memory,subagent-router,aria-filedown,\
deep-investigation,tool-evaluator,agent-human-debug,network-debug,\
engineering-method-selector,progressive-doc,rd-mode,claude-proj-skill-linker,\
handoff-portable,skill-to-prompt,advise-motion-effects,reptlite

# my-prompts.md 的三个维护清单
# 这些变量只记录提示词正文的分类和顺序。
# 它们不安装 Skill，不生成文档，也不参与 MAIN_LIST。
#
# 清单                         内容范围                 是否要求本仓库有同名 Skill
# MY_PROMPTS_LIST              本仓库的普通聊天项        通常要求
# MY_PROMPTS_TOOLS_LIST        本仓库的工具型项          要求
# MY_PROMPTS_THIRD_PARTY_LIST  第三方已完成项            不要求
#
# 增删名称时，必须同步更新 my-prompts.md、来源说明和末尾排除清单。
# 更新后，必须检查来源、标签、正文顺序和字数。

# 普通聊天项：普通聊天 AI 可以独立执行的 Skill。
# 诊断项可以要求用户执行命令并回传结果。
# AI 不得声称已经执行用户本地的命令。
MY_PROMPTS_LIST=nano-prompt,progressive-doc,wechat-headlines,skill-to-prompt,\
tutor-man,pro-grilling,engineering-method-selector,\
agent-human-debug,joint-debugging,network-debug,handoff-portable

# 工具型项：依赖联网、文件操作、专用 CLI 或其他真实工具的 Skill。
# 这类项不得改写成不需要工具即可完成的普通聊天能力。
# linker 与 mirror 必须保留完整原 CLI 和必要配置。
# 不得用手工操作冒充 linker 或 mirror 的等效实现。
MY_PROMPTS_TOOLS_LIST=debug-instrumentation,ntl-script-descriptions,claude-proj-skill-linker,\
deep-investigation,dockerhub-mirror,software-license-checker,tool-evaluator,reptlite

# 第三方已完成项：正文已完成，但来源不是本仓库的 Skill。
# 这类项不要求 skills/ 下存在同名目录。
# 这类项不纳入 MAIN_LIST、安装索引或 marketplace。
# 来源与能力要求见 my-prompts.md 和 my-prompts-sources.md。
MY_PROMPTS_THIRD_PARTY_LIST=ste,wayfinder,grilling,humanizer-zh,\
infocard-white-purple-style,infocard-bigwhite-style,writing-for-agents

# Q 风格缺少前置生成指南与完整 HTML 模板。
# 补齐并验收前，不得加入已完成清单。
MY_PROMPTS_THIRD_PARTY_PENDING=infocard-q-style


# ----

SKILL_TO_PROMPT_ADDON__reptlite=无需支持完整参数, 子Agent要包含所用模型列,粘贴不要立即开始, 提示词版本:rpk停止, :rpi 显示单次信息: :rp 开始(默认2分钟), :rp3(3分钟), 其他参数提示词版可以不支持
