# ChatGPT Web skill must reuse the existing logged-in Chrome CDP endpoint.
AGENT_BROWSER_CDP_PORT=9696
AGENT_BROWSER_USE_DEFAULT_CDP_SESSION=1

# 在.claude-plugin/marketplace.json中加入
MAIN_LIST=chatgpt-web-skill,debug-instrumentation,\
dockerhub-mirror,git-up,joint-debugging,ntl-script-descriptions,\
pro-grilling,project-self-memory,subagent-router,aria-filedown,\
deep-investigation,tool-evaluator,agent-human-debug,network-debug,\
engineering-method-selector,progressive-doc,rd-mode,claude-proj-skill-linker,\
handoff-portable,skill-to-prompt,advise-motion-effects

# my-prompts.md 收录清单：仅列普通聊天 AI 可独立使用的 Skill；顺序与文档一致。
# 各提示词正文最多 720 字；诊断类允许用户执行命令并回传，AI 不得冒称已执行。
# 增删名称时同步更新 my-prompts.md 正文与末尾排除清单，并重新检查来源、标签和字数。
# 本清单只作维护记录，不参与 MAIN_LIST 的插件主分组，也不会自动生成文档。
MY_PROMPTS_LIST=nano-prompt,progressive-doc,wechat-headlines,skill-to-prompt,\
tutor-man,pro-grilling,engineering-method-selector,\
agent-human-debug,joint-debugging,network-debug,handoff-portable
